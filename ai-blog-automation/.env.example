# Database Configuration
# Local dev: connect to the docker-compose Postgres exposed on localhost:5432
DATABASE_URL=postgresql://user:password@localhost:5432/blog_db
# Inside docker-compose the host is the service name instead:
#   DATABASE_URL=postgresql://user:password@db:5432/blog_db
DATABASE_ECHO=false

# OpenRouter API (single LLM gateway for all AI tasks: drafting, fact-checking, briefs, SEO meta, evidence search)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
OPENROUTER_SEARCH_MODEL=perplexity/llama-3.1-sonar-large-128k-online

# Ahrefs API
AHREFS_API_KEY=...

# Copyscape API
COPYSCAPE_API_KEY=...
COPYSCAPE_USERNAME=...

# WordPress Configuration
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=...
WORDPRESS_APP_PASSWORD=...

# Google APIs
GOOGLE_ANALYTICS_PROPERTY_ID=...
GOOGLE_SEARCH_CONSOLE_SITE_URL=...
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs

# Alert Configuration (optional)
SLACK_WEBHOOK_URL=...
ALERT_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=...
SMTP_PASSWORD=...

MOCK_MODE=True